{
  "openapi": "3.1.0",
  "info": { "title": "Langflow-min", "version": "1.0.0" },
  "paths": {
    "/api/v1/users/": {
      "post": {
        "tags": ["Users"],
        "summary": "Add User",
        "description": "Add a new user to the database.\n\nThis endpoint allows public user registration (sign up).\nUser activation is controlled by the NEW_USER_IS_ACTIVE setting.",
        "operationId": "add_user_api_v1_users__post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserCreate" }
            }
          }
        },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/api/v1/users/whoami": {
      "get": {
        "tags": ["Users"],
        "summary": "Read Current User",
        "operationId": "read_current_user_api_v1_users_whoami_get",
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "components": {
    "schemas": {
      "UserCreate": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "title": "Username" },
          "password": { "type": "string", "title": "Password" },
          "optins": { "type": "object", "title": "Optins" }
        }
      }
    }
  }
}
