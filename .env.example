# Target owner/baseline actor
AUTH_TOKEN=
AUTH_HEADER_NAME=Authorization
AUTH_HEADER_PREFIX=Bearer
ACTOR_ID=owner_a
ACTOR_ROLE=user

# Optional second same-role user used for cross-user BOLA tests
# These values are only required when --bootstrap-actors manual is used or
# automatic signup/login cannot pass OTP, CAPTCHA, SSO, or email verification.
ATTACKER_AUTH_TOKEN=
ATTACKER_ACTOR_ID=user_b
ATTACKER_ROLE=user
ATTACKER_USER_ID=
ATTACKER_EMAIL=

# Optional administrator context for role-matrix/BFLA tests
ADMIN_AUTH_TOKEN=
ADMIN_ACTOR_ID=admin

# Optional seed values consumed by the baseline flow
# SEED_email=owner@example.test
# SEED_password=StrongPassword123!

# Local model integration
OLLAMA_ENABLED=false
